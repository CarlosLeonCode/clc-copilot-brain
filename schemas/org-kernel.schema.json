{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clc-copilot-brain.dev/schemas/org-kernel.schema.json",
  "title": "Organization Kernel Schema",
  "description": "Schema for the organization profile and active areas configuration in the Second Brain Engine",
  "type": "object",
  "required": ["version", "organization", "activeAreas", "governance"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "organization": {
      "type": "object",
      "required": ["name", "industry", "tagline"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "legalName": {
          "type": "string"
        },
        "industry": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "foundedYear": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "headquarters": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "activeAreas": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Area folder id: a preset (sales, marketing, product, operations, hr_people, finance_legal) or a custom area created with `add-area --custom`.",
        "pattern": "^[a-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "governance": {
      "type": "object",
      "required": ["owner", "reviewCadenceDays"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "coreTeam": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewCadenceDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 365
        }
      },
      "additionalProperties": true
    },
    "ecosystemTools": {
      "type": "object",
      "description": "Recommended or integrated tools within the organization ecosystem",
      "additionalProperties": {
        "type": "object",
        "required": ["tool", "repository", "purpose"],
        "properties": {
          "tool": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "aiAdapters": {
      "type": "object",
      "properties": {
        "ssotPath": {
          "type": "string",
          "default": "AGENTS.md"
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["CLAUDE.md", "GEMINI.md", ".cursorrules", ".windsurfrules"]
          }
        },
        "skillsDirectory": {
          "type": "string",
          "default": ".agents/skills"
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "schemaVersion": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
