{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clc-copilot-brain.dev/schemas/org-kernel.schema.json",
  "title": "Organization Kernel Schema",
  "description": "Schema for the organization profile and active areas configuration in the Second Brain Engine",
  "type": "object",
  "required": ["version", "organization", "activeAreas", "governance"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "language": {
      "type": "string",
      "description": "Language the assistant and the sales page use for people: en (English) or es (Spanish). English when missing.",
      "enum": ["en", "es"]
    },
    "methodology": {
      "type": "string",
      "description": "How the team sells, which sets the starter sales stages, qualification and terms: meddpicc (enterprise deals with many stakeholders) or sandler (small and mid-size businesses, short cycles). Any other lowercase slug names a team's own method. meddpicc when missing.",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "examples": ["meddpicc", "sandler"]
    },
    "setup": {
      "type": "object",
      "description": "Whether the guided setup (\"Let's set up my brain\") has been done. Missing in brains made before this field existed.",
      "required": ["completed"],
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "organization": {
      "type": "object",
      "required": ["name", "industry", "tagline"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "legalName": {
          "type": "string"
        },
        "industry": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "foundedYear": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "headquarters": {
          "type": "string"
        },
        "positioning": {
          "type": "string",
          "minLength": 1,
          "description": "One or two sentences on why buyers choose us over the alternatives."
        },
        "targetSegments": {
          "type": "array",
          "description": "Who we sell to: a plain name per segment, or an object with a name and any notes.",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "type": "string", "minLength": 1 } },
                "additionalProperties": true
              }
            ]
          }
        },
        "offer": {
          "type": "object",
          "description": "What we sell and what it costs. Prices are never invented: only what is written here.",
          "properties": {
            "businessModel": { "type": "string", "minLength": 1 },
            "excludedCosts": { "type": "string" },
            "plans": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "priceUsdMonthly"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "priceUsdMonthly": { "type": "number", "minimum": 0 },
                  "limits": {
                    "description": "What the plan includes, as named values or a plain sentence. Other plan fields (for example messagesPerMonth) are also kept.",
                    "oneOf": [{ "type": "object" }, { "type": "string" }]
                  }
                },
                "additionalProperties": true
              }
            },
            "pricesVerifiedAt": {
              "description": "When the prices were last checked: a date (2026-10-21) or a date-time.",
              "anyOf": [
                { "type": "string", "format": "date" },
                { "type": "string", "format": "date-time" }
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "activeAreas": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Area folder id: a preset (sales, marketing, product, operations, hr_people, finance_legal) or a custom area created with `add-area --custom`.",
        "pattern": "^[a-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "governance": {
      "type": "object",
      "required": ["owner", "reviewCadenceDays"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "coreTeam": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewCadenceDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 365
        },
        "weeklyReview": {
          "type": "string",
          "minLength": 1,
          "description": "What the team reviews every week, in a plain sentence."
        }
      },
      "additionalProperties": true
    },
    "ecosystemTools": {
      "type": "object",
      "description": "Recommended or integrated tools within the organization ecosystem",
      "additionalProperties": {
        "type": "object",
        "required": ["tool", "repository", "purpose"],
        "properties": {
          "tool": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "aiAdapters": {
      "type": "object",
      "properties": {
        "ssotPath": {
          "type": "string",
          "default": "AGENTS.md"
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["CLAUDE.md", "GEMINI.md", ".cursorrules", ".windsurfrules"]
          }
        },
        "skillsDirectory": {
          "type": "string",
          "default": ".agents/skills"
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "schemaVersion": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
